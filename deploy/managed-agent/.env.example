# Opt-in, one-generation canary. Use absolute host paths; do not place a key
# or bearer value in this file. Pin image digests before using a real relay.
BUZZ_BROKER_HOST_IMAGE=buzz-broker-host:canary
BUZZ_SPRIG_IMAGE=buzz-sprig:canary
BUZZ_BROKER_STATE_DIR=/absolute/private/broker-state
BUZZ_BROKER_SIGNING_DIR=/absolute/private/broker-signing
BUZZ_BROKER_CREDENTIAL_DIR=/absolute/private/broker-credential
BUZZ_BROKER_AUTHORITY_FILE=/absolute/private/authority.json
BUZZ_AGENT_WORKSPACE_DIR=/absolute/agent-workspace
BUZZ_RELAY_URL=wss://relay.example
BUZZ_ACP_CHANNELS=11111111-1111-4111-8111-111111111111
BUZZ_ACP_AGENT_OWNER=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BUZZ_ACP_AGENT_COMMAND=buzz-agent
